# Copie para .env.local. Nenhum segredo entra aqui: o build do frontend é público por definição.

# Alvo do proxy de desenvolvimento (usado só pelo `npm run dev`).
DEV_API_TARGET=http://localhost:5000

# Base das chamadas REST/SignalR no build.
# Vazio = caminho relativo, assumindo que /api e /hubs chegam ao mesmo host (proxy do nginx ou Ingress).
# Preencha apenas se a API ficar em outra origem — nesse caso a origem do frontend precisa estar na
# lista de CORS da sage-kahoot-api.
VITE_API_BASE_URL=

# Endereço exibido no telão para o participante entrar. Padrão: a própria origem do frontend.
VITE_JOIN_URL_BASE=
